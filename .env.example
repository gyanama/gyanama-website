# ============================================
# GYANAMA Website Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- SERVER-SIDE ONLY (Vercel API route — never exposed to browser) ---

# EmailJS Configuration (https://www.emailjs.com/)
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key

# Contact email (where demo requests are sent)
CONTACT_EMAIL=gyanamaedu@gmail.com

# Supabase — SERVER-SIDE keys (used by api/track.ts, api/trigger-rebuild.ts and
# scripts/prerender.mjs). The service-role key bypasses RLS — NEVER prefix with
# VITE_ and never expose it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Vercel Deploy Hook URL (Project Settings → Git → Deploy Hooks). Publishing a
# blog post POSTs this to trigger a rebuild so the post is prerendered.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxxxx

# IndexNow (Bing / Yandex — Google does not participate). Generate the key in
# Bing Webmaster Tools → IndexNow. It is NOT a secret: scripts/prerender.mjs
# publishes it at /<key>.txt on every build, which is how Bing verifies domain
# ownership. Unset = feature is a no-op. 8–128 chars of [A-Za-z0-9-].
INDEXNOW_KEY=

# Set to "true" for ONE deploy to submit every sitemap URL, then remove it.
# Left on, it resubmits unchanged URLs on every deploy, which IndexNow discourages.
INDEXNOW_SUBMIT_ALL=

# --- CLIENT-SIDE (VITE_ prefix — embedded in browser bundle) ---

# Cal.com Scheduling Integration
# Your Cal.com username (e.g., "gyanama" for cal.com/gyanama)
VITE_CAL_USERNAME=your_calcom_username
# The event type slug (e.g., "15min-demo")
VITE_CAL_EVENT_SLUG=15min-demo

# Supabase — CLIENT-SIDE keys (anon key is safe to expose; access is gated by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
