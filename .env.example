# ============================================
# GYANAMA Website Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- SERVER-SIDE ONLY (Netlify Function — never exposed to browser) ---

# EmailJS Configuration (https://www.emailjs.com/)
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key

# Contact email (where demo requests are sent)
CONTACT_EMAIL=gyanamaedu@gmail.com

# Cloudflare Turnstile SECRET key (https://dash.cloudflare.com/turnstile)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# --- CLIENT-SIDE (VITE_ prefix — embedded in browser bundle) ---

# Cloudflare Turnstile SITE key (safe to expose — it's a public key)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Cal.com Scheduling Integration
# Your Cal.com username (e.g., "gyanama" for cal.com/gyanama)
VITE_CAL_USERNAME=your_calcom_username
# The event type slug (e.g., "15min-demo")
VITE_CAL_EVENT_SLUG=15min-demo
