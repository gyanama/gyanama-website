# GYANAMA website environment variables
# Copy this file to .env and fill in your values.

# Server only. Never exposed to the browser.

# Supabase service role key, used by the API routes (track, revalidate).
# It bypasses RLS. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# IndexNow key for Bing and Yandex (Google does not take part).
# Not a secret: the build writes it to public/<key>.txt so Bing can verify the domain.
# 8 to 128 characters of A-Z, a-z, 0-9 and hyphen. Leave empty to turn IndexNow off.
INDEXNOW_KEY=

# Set to "true" for one deploy to submit every sitemap URL, then remove it.
INDEXNOW_SUBMIT_ALL=

# Browser. NEXT_PUBLIC_ values are built into the client bundle.

# Supabase public keys. The anon key is safe to expose because RLS guards access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
